# Copy to .env.local (or .env) and fill in real credentials. Keep the copied file out of source control.
DB_URL=jdbc:mysql://localhost:3306/rental_db
DB_USERNAME=root
DB_PASSWORD=change-me

SECURITY_JWT_SECRET=replace-with-long-random-string

MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=your-mailtrap-username
MAIL_PASSWORD=your-mailtrap-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

MAIL_FROM=no-reply@julia-auto-cars.com
MAIL_RESET_BASE_URL=https://rental-app-frontend-six.vercel.app/reset-password
MAIL_RESET_TTL_MINUTES=10
